{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(uv run --with-requirements requirements.txt marimo check *)",
      "Bash(uv run --with-requirements requirements.txt marimo export *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/marimo-check.sh",
            "timeout": 90,
            "statusMessage": "marimo check"
          }
        ]
      }
    ]
  }
}
